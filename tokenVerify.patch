+  /**
+   * Create a Better Auth session for the user
+   */
+  private async createSession(userId: string, ipAddress?: string, userAgent?: string): Promise<string> {
+    // Generate session token using nanoid (32 chars like Better Auth)
+    const sessionToken = createNanoId(32)();
+    const sessionId = createNanoId(12)();
+    const now = new Date();
+
+    // Session expires in 7 days (Better Auth default)
+    const expiresAt = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);
+
+    log('Creating session for user: %s, token: %s', userId, sessionToken);
+
+    await this.db.insert(session).values({
+      id: sessionId,
+      token: sessionToken,
+      userId,
+      expiresAt,
+      ipAddress: ipAddress || null,
+      userAgent: userAgent || null,
+      createdAt: now,
+      updatedAt: now,
+    });
+
+    return sessionToken;
+  }
+
+  /**
+   * Authenticate user using token from cookie
+   *
+   * @param token - The token extracted from cookie
+   * @param ipAddress - Optional IP address for session
+   * @param userAgent - Optional user agent for session
+   * @returns TokenAuthResult with session token and user ID, or null if authentication fails
+   */
+  async authenticateWithToken(
+    token: string,
+    ipAddress?: string,
+    userAgent?: string,
+  ): Promise<TokenAuthResult | null> {
+    // Verify token with external API
+    const userInfo = await this.verifyTokenWithExternalApi(token);
+    if (!userInfo) {
+      log('Token verification returned no user info');
+      return null;
+    }
+
+    // Find or create user
+    const userId = await this.findOrCreateUser(userInfo);
+
+    // Create session
+    const sessionToken = await this.createSession(userId, ipAddress, userAgent);
+
+    return {
+      sessionToken,
+      userId,
+    };
+  }
