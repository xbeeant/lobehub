+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { TokenAuthService } from '@/server/services/tokenAuth';
+
+// Mock the database
+const mockDb = {
+    query: {
+        users: {
+            findFirst: vi.fn(),
+        },
+    },
+    insert: vi.fn().mockReturnValue({
+        values: vi.fn().mockReturnValue({
+            returning: vi.fn(),
+        }),
+    }),
+};
+
+// Mock fetch for external API
+const mockFetch = vi.fn();
+global.fetch = mockFetch;
+
+// Mock UserService - all mocks must be defined inside the factory function
+vi.mock('@/server/services/user', () => ({
+    UserService: vi.fn().mockImplementation(() => ({
+        initUser: vi.fn().mockResolvedValue(undefined),
+    })),
+}));
+
+// Mock authEnv
+vi.mock('@/envs/auth', () => ({
+    authEnv: {
+        AUTH_TOKEN_VERIFY_URL: 'https://example.com/api/user',
+        AUTH_TOKEN_COOKIE_KEY: 'token',
+        AUTH_TOKEN_USER_INFO_ID_KEY: 'id',
+        AUTH_TOKEN_USER_INFO_EMAIL_KEY: 'email',
+        AUTH_TOKEN_USER_INFO_NAME_KEY: 'name',
+        AUTH_TOKEN_DEFAULT_EMAIL_DOMAIN: 'lobehub.com',
+    },
+}));
+
+describe('TokenAuthService', () => {
+    beforeEach(() => {
+        vi.clearAllMocks();
+        // Reset mock implementations
+        mockDb.insert.mockReturnValue({
+            values: vi.fn().mockReturnValue({
+                returning: vi.fn(),
+            }),
+        });
+    });
+
+    afterEach(() => {
+        vi.resetAllMocks();
+    });
+
+    describe('static methods', () => {
+        it('isTokenAuthEnabled should return true when AUTH_TOKEN_VERIFY_URL is set', () => {
+            expect(TokenAuthService.isTokenAuthEnabled()).toBe(true);
+        });
+
+        it('getTokenCookieKey should return the configured cookie key', () => {
+            expect(TokenAuthService.getTokenCookieKey()).toBe('token');
+        });
+
+        it('extractTokenFromCookie should extract token from cookie header', () => {
+            const cookieHeader = 'token=test-token; other=value';
+            const token = TokenAuthService.extractTokenFromCookie(cookieHeader);
+            expect(token).toBe('test-token');
+        });
+
+        it('extractTokenFromCookie should return null when token not found', () => {
+            const cookieHeader = 'other=value; another=test';
+            const token = TokenAuthService.extractTokenFromCookie(cookieHeader);
+            expect(token).toBeNull();
+        });
+
+        it('extractTokenFromCookie should return null when cookie header is null', () => {
+            const token = TokenAuthService.extractTokenFromCookie(null);
+            expect(token).toBeNull();
+        });
+    });
+
+    describe('authenticateWithToken', () => {
+        it('should return null when external API returns non-OK status', async () => {
+            mockFetch.mockResolvedValueOnce({
+                ok: false,
+                status: 401,
+            });
+
+            const service = new TokenAuthService(mockDb as any);
+            const result = await service.authenticateWithToken('test-token');
+
+            expect(result).toBeNull();
+            expect(mockFetch).toHaveBeenCalledWith(
+                'https://example.com/api/user',
+                {
+                    headers: {
+                        Cookie: 'token=test-token',
+                    },
+                },
+            );
+        });
+
+        it('should return null when user info missing both id and name', async () => {
+            mockFetch.mockResolvedValueOnce({
+                ok: true,
+                json: async () => ({ email: 'test@example.com' }),
+            });
+
+            const service = new TokenAuthService(mockDb as any);
+            const result = await service.authenticateWithToken('test-token');
+
+            expect(result).toBeNull();
+        });
+
+        it('should create new user when user does not exist', async () => {
+            mockFetch.mockResolvedValueOnce({
+                ok: true,
+                json: async () => ({
+                    id: 'external-user-id',
+                    email: 'test@example.com',
+                    name: 'Test User',
+                }),
+            });
+
+            mockDb.query.users.findFirst.mockResolvedValueOnce(null);
+
+            const mockReturning = vi.fn().mockResolvedValueOnce([
+                {
+                    id: 'user_external-user-id',
+                    email: 'test@example.com',
+                    fullName: 'Test User',
+                    createdAt: new Date(),
+                },
+            ]);
+
+            mockDb.insert.mockReturnValueOnce({
+                values: vi.fn().mockReturnValueOnce({
+                    returning: mockReturning,
+                }),
+            });
+
+            const service = new TokenAuthService(mockDb as any);
+            const result = await service.authenticateWithToken('test-token');
+
+            expect(result).not.toBeNull();
+            expect(result?.userId).toBeDefined();
+            expect(result?.sessionToken).toBeDefined();
+        });
+
+        it('should generate email from name when email is not provided', async () => {
+            mockFetch.mockResolvedValueOnce({
+                ok: true,
+                json: async () => ({
+                    id: 'external-user-id',
+                    name: 'Test User Name',
+                }),
+            });
+
+            mockDb.query.users.findFirst.mockResolvedValueOnce(null);
+
+            const mockReturning = vi.fn().mockResolvedValueOnce([
+                {
+                    id: 'user_external-user-id',
+                    email: 'test.user.name@lobehub.com',
+                    fullName: 'Test User Name',
+                    createdAt: new Date(),
+                },
+            ]);
+
+            mockDb.insert.mockReturnValueOnce({
+                values: vi.fn().mockReturnValueOnce({
+                    returning: mockReturning,
+                }),
+            });
+
+            const service = new TokenAuthService(mockDb as any);
+            const result = await service.authenticateWithToken('test-token');
+
+            expect(result).not.toBeNull();
+            expect(result?.userId).toBeDefined();
+        });
+
+        it('should use existing user when user exists by email', async () => {
+            mockFetch.mockResolvedValueOnce({
+                ok: true,
+                json: async () => ({
+                    email: 'existing@example.com',
+                    name: 'Existing User',
+                }),
+            });
+
+            mockDb.query.users.findFirst.mockResolvedValueOnce({
+                id: 'existing-user-id',
+                email: 'existing@example.com',
+            });
+
+            const mockReturning = vi.fn().mockResolvedValueOnce([
+                {
+                    id: 'session-id',
+                    token: 'session-token',
+                    userId: 'existing-user-id',
+                    expiresAt: new Date(),
+                },
+            ]);
+
+            mockDb.insert.mockReturnValueOnce({
+                values: vi.fn().mockReturnValueOnce({
+                    returning: mockReturning,
+                }),
+            });
+
+            const service = new TokenAuthService(mockDb as any);
+            const result = await service.authenticateWithToken('test-token');
+
+            expect(result).not.toBeNull();
+            expect(result?.userId).toBe('existing-user-id');
+        });
+
+        it('should handle non-string values in response', async () => {
+            mockFetch.mockResolvedValueOnce({
+                ok: true,
+                json: async () => ({
+                    id: 123, // number instead of string
+                    email: 'test@example.com',
+                    name: null, // null instead of string
+                }),
+            });
+
+            const service = new TokenAuthService(mockDb as any);
+            const result = await service.authenticateWithToken('test-token');
+
+            // Should return null because id is not a string and name is null
+            expect(result).toBeNull();
+        });
+    });
+});
